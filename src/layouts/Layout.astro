---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="AI-powered audio privacy for Bluetooth headphones. Your AI hears you. Your neighbors can't." />
    <meta name="theme-color" content="#1e3a8a" />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        height: 100%;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
        color: #e0e7ff;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      header {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(59, 130, 246, 0.2);
        padding: 1rem 2rem;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      header nav {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      header .logo {
        font-size: 1.5rem;
        font-weight: bold;
        color: #60a5fa;
      }

      header nav ul {
        list-style: none;
        display: flex;
        gap: 2rem;
      }

      header nav a {
        color: #93c5fd;
        text-decoration: none;
        transition: color 0.3s;
        font-size: 0.95rem;
      }

      header nav a:hover {
        color: #bfdbfe;
      }

      main {
        flex: 1;
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        width: 100%;
      }

      footer {
        background: rgba(15, 23, 42, 0.8);
        border-top: 1px solid rgba(59, 130, 246, 0.2);
        padding: 2rem;
        text-align: center;
        color: #94a3b8;
        font-size: 0.9rem;
      }

      footer a {
        color: #93c5fd;
        text-decoration: none;
        transition: color 0.3s;
      }

      footer a:hover {
        color: #bfdbfe;
      }

      h1, h2, h3 {
        color: #60a5fa;
      }

      a {
        color: #93c5fd;
        text-decoration: none;
        transition: color 0.3s;
      }

      a:hover {
        color: #bfdbfe;
      }

      button {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 1rem;
        transition: background 0.3s;
      }

      button:hover {
        background: #2563eb;
      }

      @media (max-width: 768px) {
        header nav {
          flex-direction: column;
          gap: 1rem;
        }

        header nav ul {
          flex-direction: column;
          gap: 1rem;
          text-align: center;
        }

        main {
          padding: 1rem;
        }

        button {
          padding: 0.6rem 1.2rem;
          font-size: 0.9rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <div class="logo">🔇 Muzzle</div>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/dashboard">Dashboard</a></li>
          <li><a href="/docs">Docs</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 Muzzle. AI-powered audio privacy. | <a href="https://github.com/voodoo/muzzle">GitHub</a></p>
    </footer>
  </body>
</html>
