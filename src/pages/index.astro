---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Muzzle — Voice Privacy & Control">
  <div class="hero">
    <h1>🔇 Muzzle</h1>
    <p class="tagline">Audio Isolation Headphones</p>
    <p class="description">
      Premium headphones engineered for audio isolation. Use them like any headphones—music, calls, podcasts. Or toggle to voice mode and talk to your AI silently, anywhere, without anyone hearing a word.
    </p>
    <p class="subtagline">Your AI hears you. Your neighbors can't.</p>
    <div class="cta">
      <button onclick="window.location.href='https://cal.com/paul-vudmaska/15min'">Get Early Access</button>
    </div>
  </div>

  <section class="features">
    <h2>Why Muzzle?</h2>
    <div class="feature-grid">
      <div class="feature">
        <h3>🎧 Premium Audio Hardware</h3>
        <p>Big, bulky by design. Engineered to muffle ambient noise and capture your voice with studio-quality clarity.</p>
      </div>
      <div class="feature">
        <h3>🤐 Silent Voice Input</h3>
        <p>Each side has a speaker + microphone. Toggle to voice mode and talk to your AI without anyone hearing a word.</p>
      </div>
      <div class="feature">
        <h3>🤖 AI Cleanup</h3>
        <p>Incomprehensible speech made clear. Both raw + cleaned versions for training and accuracy.</p>
      </div>
      <div class="feature">
        <h3>🏥 Respectful Everywhere</h3>
        <p>Use voice commands in offices, hospitals, transit, waiting rooms. No one knows you're talking to AI.</p>
      </div>
    </div>
  </section>

  <section class="status">
    <h2>Status</h2>
    <p>🚀 Early Development — v1.0 coming soon</p>
    <p class="status-detail">Static site. Clean messaging. No over-engineering.</p>
  </section>

  <section class="roadmap">
    <h2>Roadmap</h2>
    <div class="timeline">
      <div class="milestone">
        <h3>v1.0 (Now)</h3>
        <p>Landing page & positioning</p>
      </div>
      <div class="milestone">
        <h3>B1 (Next)</h3>
        <p>Audio privacy + transcription</p>
      </div>
      <div class="milestone">
        <h3>Phase 3 (Future)</h3>
        <p>AI cleanup pipeline</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 6rem 2rem;
    margin-bottom: 4rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 8vw, 4rem);
    margin-bottom: 1rem;
    color: #60a5fa;
    font-weight: 700;
  }

  .tagline {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    color: #93c5fd;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .description {
    font-size: 1.1rem;
    color: #cbd5e1;
    max-width: 600px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  .subtagline {
    font-size: 1.25rem;
    color: #60a5fa;
    max-width: 600px;
    margin: 0 auto 2.5rem;
    font-weight: 600;
    font-style: italic;
  }

  .cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta button {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.3s;
  }

  .cta button:hover {
    background: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
  }

  .features {
    margin: 6rem 0;
  }

  .features h2 {
    text-align: center;
    margin-bottom: 3rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    color: #60a5fa;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature {
    background: rgba(30, 58, 138, 0.4);
    padding: 2rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(59, 130, 246, 0.5);
    transition: all 0.3s;
  }

  .feature:hover {
    transform: translateY(-5px);
    background: rgba(30, 58, 138, 0.6);
    border-color: #3b82f6;
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.15);
  }

  .feature h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    color: #93c5fd;
  }

  .feature p {
    color: #cbd5e1;
    line-height: 1.5;
  }

  .status {
    text-align: center;
    padding: 3rem 2rem;
    background: rgba(30, 58, 138, 0.3);
    border-radius: 0.75rem;
    margin: 4rem 0;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .status h2 {
    margin-bottom: 1rem;
    color: #60a5fa;
  }

  .status p {
    color: #cbd5e1;
    font-size: 1.1rem;
  }

  .status-detail {
    font-size: 0.95rem;
    color: #94a3b8;
    margin-top: 0.5rem;
  }

  .roadmap {
    margin: 6rem 0;
  }

  .roadmap h2 {
    text-align: center;
    margin-bottom: 3rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    color: #60a5fa;
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .milestone {
    background: rgba(30, 58, 138, 0.4);
    padding: 2rem;
    border-radius: 0.75rem;
    border-left: 4px solid #3b82f6;
    text-align: center;
  }

  .milestone h3 {
    color: #93c5fd;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .milestone p {
    color: #cbd5e1;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 1.5rem;
    }

    .cta button {
      padding: 0.75rem 1.5rem;
      font-size: 0.95rem;
    }
  }
</style>
